@ARTICLE{Stevens2021-or,
  title    = "Opioid withdrawal behavior in spiny mice: A novel preclinical
              model of neonatal opioid withdrawal syndrome ({NOWS})",
  author   = "Stevens, Sarah and Mohan, Shekher",
  journal  = "Heliyon",
  abstract = ", more commonly known as spiny mice, which have an extended 40-day
              gestation period, small litter sizes, and increased in utero
              organogenesis we aim to study the short-term effects of prenatal
              morphine exposure by assessing withdrawal behavior. To model
              maternal opioid use, dams were treated daily with morphine (10 and
              30 mg/kg S.C.) beginning on gestation day 19 until the day of
