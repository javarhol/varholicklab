  author   = "Kronfeld‐Schor, Noga and Zisapel, Nava and Haim, Abraham",
  journal  = "Birkhäuser Basel eBooks",
  abstract = "Non-shivering thermogenesis (NST) is an important mechanism for
              rapidly increasing heat production in winter-acclimatized, as well
              as in cold- and long-scotophase acclimated small mammals (1,2,3).
