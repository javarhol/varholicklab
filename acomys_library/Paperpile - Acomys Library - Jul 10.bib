@ARTICLE{Bedrak1973-fe,
  title    = "{ANDROGEN} {BIOSYNTHESIS} {BY} {TESTICULAR} {TISSUE} {OF} {THE}
              {DESERT} {RODENTS}, \textit{ACOMYS {CAHIRINUS}} {AND}
              \textit{GERBILLUS {DASYURUS}}",
  author   = "Bedrak, E and Samoiloff, V and Shachak, Moshe",
  journal  = "Reproduction",
  abstract = "Summary. Androgen biosynthesis was investigated in the desert
              rodents, Acomys cahirinus and Gerbillus dasyurus. In these
              experiments, radioactive substrates were incubated with testicular
              homogenates and the metabolites formed were identified. The
              accumulation of 5-ene-3β-hydroxysteroids suggested that the
              biosynthesis proceeded preferentially by the 4-ene route. This was
              confirmed by double-label experiments where
              [3H]5-ene-3β-hydroxysteroids and [14C]4-en-3-oxosteroids were
