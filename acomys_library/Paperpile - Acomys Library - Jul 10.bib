  keywords = "regeneration; spiny mouse; acomys; blastema; muscle regeneration"
}

@ARTICLE{Brant2019-mh,
  title    = "Comparative transcriptomic analysis of dermal wound healing
              reveals de novo skeletal muscle regeneration in Acomys cahirinus",
