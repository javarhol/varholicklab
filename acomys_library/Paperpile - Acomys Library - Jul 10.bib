@ARTICLE{De_Bruin2014-wl,
  title    = "The pattern of ovulation in the southern African spiny mouse
              (Acomys spinosissimus)",
  author   = "de Bruin, P Ruan and Ganswindt, André and Bennett, Nigel C and
