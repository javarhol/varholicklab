@ARTICLE{Sekulic2022-op,
  title    = "Which precocial rodent species is more suitable as the
              experimental model of microgravity influence on prenatal
              musculosketal development on international space station?",
  author   = "Sekulić, Slobodan and Jovanović, Aleksandar and Živanović, Željko
