@ARTICLE{Tomasso2024-xh,
  title    = "Marvels of spiny mouse regeneration: cellular players and their
              interactions in restoring tissue architecture in mammals",
  author   = "Tomasso, Antonio and Disela, Vanessa and Longaker, Michael T and
              Bartscherer, Kerstin",
  journal  = "Curr. Opin. Genet. Dev.",
  abstract = "Understanding the cellular and molecular determinants of mammalian
              tissue regeneration and repair is crucial for developing effective
              therapies that restore tissue architecture and function. In this
