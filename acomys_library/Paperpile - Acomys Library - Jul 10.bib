@ARTICLE{Nguyen2023-hw,
  title    = "{GENOME} {REPORT}: Chromosome-scale genome assembly of the African
              spiny mouse ( \textit{Acomys cahirinus} )",
  author   = "Nguyen, Elizabeth D and Fard, Vahid Nikoonejad and Kim, Bernard
              and Collins, Sarah and Galey, Miranda and Nelson, Branden R and
              Wakenight, Paul and Gable, Simone M and McKenna, Aaron and
              Bammler, Theo K and MacDonald, Jim and Okamura, Daryl M and
              Shendure, Jay and Beier, David R and Ramirez, Jan‐marino and
              Majesky, Mark W and Millen, Kathleen J and Tollis, Marc and
              Miller, Danny E",
  journal  = "bioRxiv (Cold Spring Harbor Laboratory)",
  abstract = "ABSTRACT There is increasing interest in the African spiny mouse (
              Acomys cahirinus ) as a model organism because of its ability for
              regeneration of tissue after injury in skin, muscle, and internal
              organs such as the kidneys. A high-quality reference genome is
