@ARTICLE{LopezSchenk2025-wy,
  title    = "Abstract {Fri135}: Metabolic Adaptations after Myocardial Ischemia
              in Adult Spiny Mouse ( \textit{Acomys)}",
  author   = "Lopez‐Schenk, Rachel and Xie, Raven and Suhan, Tahra K and
              Sajjakulnukit, Peter and Whitesall, Steven E and Lyssiotis, Costas
              A and Michele, Daniel E and Abdel‐Latif, Ahmed",
  journal  = "Circ. Res.",
  abstract = "Background: Ischemic cardiomyopathy is caused by inadequate blood
              supply, leading to heart failure through cell death and metabolic
              disruption. Unlike most organs, adult heart tissue cannot
              regenerate. The Acomys mouse, however, shows healing abilities and
              maintains better heart function after myocardial infarction than
              typical laboratory mice (C57BL/6 Mus ). This study compares the
              metabolic profiles of Acomys and Mus to identify mechanisms of
              Acomys cardiac resilience to injury. Methods/Approach: Myocardial
              infarction (MI) in Acomys and the Mus was induced by LAD ligation.
              We conducted metabolomic analysis on heart tissue from sham and MI
              animals (day 1, 3, and 7 post MI). Oxygen consumption rate of
              isolated cardiomyocytes from both species was quantified using the
              Seahorse system. Results/Data: Following MI, Acomys mice
              demonstrate metabolic advantages over Mus mice. While both species
              show increased amino acid metabolism after MI, this change is more
              dramatic in Mus . Acomys exhibit stronger upregulation of several
              key metabolic pathways post MI, including the pentose phosphate
              pathway (PPP), glycolysis gluconeogenesis, purine metabolism, and
              pentose glucuronate interconversions. Despite having a higher
              baseline metabolic rate but lower reserve capacity, Acomys
              experience smaller decreases in basal respiration and ATP
              production after MI, indicating better preservation of metabolic.
              In contrast, Mus show greater increases in non-mitochondrial
              oxygen consumption following MI, suggesting a more pronounced
              oxidative stress response. Conclusion: The metabolic adaptations
              in Acomys , characterized by enhanced glycolysis, activation of
              the PPP, and improved antioxidant capacity, likely contribute to
              their cardiac resilience and recovery following MI. This metabolic
              profile allows Acomys to better manage energy demands and
              oxidative stress during cardiac injury, potentially supporting the
              enhanced survival capacity of cardiomyocytes.",
  year     =  2025
}

@ARTICLE{Dergilev2025-oy,
  title    = "Spiny mice (Acomys): a novel and perspective model for research of
              heart regeneration and development of regenerative technologies",
  author   = "Dergilev, K V and Dolgodvorova, A A and Goltseva, Yu D and
              Parfyonova, Ye V",
  journal  = "Russian Cardiology Bulletin",
  abstract = "While reparative regeneration of the heart is robust in lower
              vertebrates (fish and newts), this capacity is extremely limited
              in mammalian heart. This regenerative failure prevents recovery
              from extensive damage and underlies pathogenesis of cardiovascular
              diseases contributing to mortality in developed countries
              (ischemic heart disease, myocardial infarction, heart failure).
              Addressing this challenge requires deciphering the regenerative
              mechanisms of complex organs and tissues, including myocardium, to
              enable development of novel technologies aimed at stimulation of
              endogenous regenerative program. Adult spiny mice (Acomys) have
              capacity for complete regeneration of skin, cartilage and skeletal
              muscles, as well as almost complete regeneration with minimal
              fibrosis of kidneys, spinal cord, and heart. This opens new
              perspectives for research of regeneration, particularly myocardial
              regeneration. This review is devoted to tissue regeneration (skin,
              ear pinna, skeletal muscles, kidneys, and spinal cord) in Acomys
              and house mice (Mus musculus). A particular emphasis is placed on
              Acomys heart regeneration and mechanisms proposed to explain this
              exceptional mammalian capability. Spiny mice (Acomys) may be a
              unique model for discovering mechanisms of regeneration in complex
              organs and tissues, particularly in the heart. Insights from this
              model hold significant potential for translation into novel
              therapeutic strategies to stimulate regeneration in humans.",
  year     =  2025
}

