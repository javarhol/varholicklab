@ARTICLE{Shkolnik1971-xp,
  title    = "Diurnal Activity in a Small Desert",
  author   = "Shkolnik, A",
  journal  = "Preprint or Abstract",
  abstract = "Two of spiny mice, namely the common spiny mouse, ACOMYS
              CAHIRINUS, and the golden spiny mouse, ACOMYS RUSSATUS, are widely
              distributed in the same desert areas of Israel. Not only do these
              two Murid rodents belong to the same genus, but they also
              coinbabit identical rocky habitats, and are very similar in their
              morphology as well as in their life history. They differ, however,
              in their daily activity patterns: the common spiny mouse is
              nocturnal, while the golden spiny mouse is frequently seen active
              during the day. Ever since the formulation of the principle of
              competitive exclusion (Gause, 1934), reports of coexistence of
              closely related species in the same area have evoked great
              interest (Hardin, 1960). Cohabitation of the same microhabitat, as
              is the case with the two of spiny mice (Shkolnik, 1960) is even
              more intriguing. In addition to the problem of coexistence of
              these two in the same microhabitat there is the additional enigma
              of the diurnal activity of the golden spiny mouse. Most desert
              rodents are nocturnal animals, thereby avoiding the full impact of
              the desert climate by withdrawing during the day to hidden
              shelters where moderate microclimate conditions prevail
              (Schmidt-Nielsen, 1964).",
  year     =  1971
}

