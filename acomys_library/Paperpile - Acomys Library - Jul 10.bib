@ARTICLE{Fleming2002-et,
  title    = "Opportunistic breeding in the Cape spiny mouse (\textit{Acomys
              subspinosus})",
  author   = "Fleming, Patricia A and Nicolson, Sue W",
  journal  = "Afr. Zool.",
  abstract = "The relationship between Protea humiflora and its small mammal
              pollinators was investigated at the fynbos/karoo ecotone in the
              Riviersonderend Mountains, South Africa. Acomys subspinosus
              occurred in low densities at Jonaskop, with around 3.9 ± 2.0 (mean
