@ARTICLE{Choshniak2008-oe,
  title    = "Heart rate as a measure of energy expenditure in a small rodent –
              the golden spiny mouse (Acomys russatus)",
  author   = "Choshniak, I and Shargal, Eyal and Brosh, Arieh",
  journal  = "FASEB J.",
  abstract = "While monitoring heart rate (f H ) as a measure of energy
              expenditure is a widely‐used approach in large animals, much
              uncertainty remains in the interpretation of results using the
              same approach in small rodents. In the present study, the validity
              of f H monitoring as an estimate of oxygen consumption rate (VO 2
              ) was tested in caged golden spiny mice under controlled
              conditions. Four mature males (72.5 ± 8.8 g) were surgically
              implanted with small transmitters (3.5g, Data Sciences
              International), enabling the continuous recording of heart rate,
              core body temperature and activity. Measurements of VO 2 were
              taken at 72 hour intervals. Animals were maintained under
              controlled conditions (30 ± 1°C, 12L‐12D), and fed either ad lib .
              or restricted to 50\% of their ad lib . food intake. Significant
              daily patterns of f H and VO 2 (P<0.001) were observed in animals
              under both feeding regimes. The daily pattern was affected mainly
              by time of feeding, particularly in the food‐restricted animals.
              Heart rate was positively related to VO 2 both in mice fed ad lib
              . (P<0.001, R 2 = 0.918), and in food‐restricted mice (P<0.001, R
              2 = 0.94). Within and between animal oxygen pulse (O 2 P) varied
              during the day and between days independently of feeding regime.
              The data suggest that despite the variability in O 2 P observed
              between and within animals, f H monitoring offers a relatively
              reliable indicator for prediction of group means VO 2 in resting
              spiny mice.",
  year     =  2008
}

