@ARTICLE{Perrin1994-im,
  title    = "{COMPARATIVE} {ASPECTS} {OF} {THE} {THERMAL} {BIOLOGY} {OF} {THE}
              {CAPE} {SPINY} {MOUSE}, {ACOMYS} {SUBSPINOSUS}, {AND} {THE}
