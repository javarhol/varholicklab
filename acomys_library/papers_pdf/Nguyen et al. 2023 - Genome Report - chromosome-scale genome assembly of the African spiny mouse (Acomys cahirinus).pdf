         </dc:publisher>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Genome Report: chromosome-scale genome assembly of the African spiny mouse (Acomys cahirinus)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
