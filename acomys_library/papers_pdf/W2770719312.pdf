tps://open.uct.ac.za/server/api/core/items/fa92bec9-82d7-446b-93ce-be2ca40581f0/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://open.uct.ac.za/server/api/core/items/fa92bec9-82d7-446b-93ce-be2ca40581f0/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://open.uct.ac.za/server/api/core/items/fa92bec9-82d7-446b-93ce-be2ca40581f0/thumbnail&q;},&q;self&q;:{&q;href&q;:&q;https://open.uct.ac.za/server/api/core/items/fa92bec9-82d7-446b-93ce-be2ca40581f0&q;}},&q;_name&q;:&q;Is the distribution of Liparia determined by disturbance or mutualism?&q;,&q;id&q;:&q;fa92bec9-82d7-446b-93ce-be2ca40581f0&q;,&q;uuid&q;:&q;fa92bec9-82d7-446b-93ce-be2ca40581f0&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.advisor&q;:[{&q;uuid&q;:&q;1dfd1581-9ed8-4de5-aa33-e4231a5d7ec6&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Midgley, Jeremy J&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;4aae260f-debf-4d12-a581-f8f48f3dd115&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Von Hase, Fabian G&q;,&q;place&q;:0,&q;authority&q;:&q;ef9dc1eb-41b4-453b-8b1a-b4051577b19e&q;,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;bcf2c521-182f-4c35-aa2c-2bc30e70f5f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2017-11-17T08:24:29Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;9e7b79a9-e0ec-4dbc-b43a-8a77023917d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2017-11-17T08:24:29Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;01efcf8f-a1b3-490a-b909-635ee752e129&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;2010&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.updated&q;:[{&q;uuid&q;:&q;41488346-08bc-4e4b-b39c-1d3080b2b019&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2017-02-01T13:24:09Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;473dc276-a4d1-40b4-ae44-1e91de8282d4&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;I investigated whether the locally endemic Liparia parva was influenced in its distribution by the distribution of its principal pollinator Acomys subspinosus or by rocks acting as buffers against disturbance by fires. Sampling was carried out at Redhill on the Cape Peninsula (South Africa) during the winter of 2010 by trapping rodents with Sherman live and PVC traps, performing vegetation analyses and analyses of its relationship with rocks. My results show no link between Acomys presence and rocks, Acomys and Liparia co-occurrence and flower visitations as a function of distance to rock; however the absence of rocks was associated with the absence of Liparia and an increase in rocks (of up to 1 m height) was associated with an increase in Liparia abundance. This suggests that the distribution of Liparia is not influenced by Acomys and that Liparia is restricted to areas with rocks. I therefore concluded that the distribution of L. parva was determined not by its mutualism, but by rocks as a buffer against disturbance.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.apacitation&q;:[{&q;uuid&q;:&q;43a65419-ae75-4d97-b98c-9b3402878daa&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Von Hase, F. G. (2010). &l;i&g;Is the distribution of Liparia determined by disturbance or mutualism?&l;/i&g;. (Thesis). University of Cape Town ,Faculty of Science ,Department of Biological Sciences. Retrieved from http://hdl.handle.net/11427/26387&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.chicagocitation&q;:[{&q;uuid&q;:&q;aa59e1cc-13fe-4414-b45c-0b457a8799bc&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Von Hase, Fabian G. &l;i&g;\&q;Is the distribution of Liparia determined by disturbance or mutualism?.\&q;&l;/i&g; Thesis., University of Cape Town ,Faculty of Science ,Department of Biological Sciences, 2010. http://hdl.handle.net/11427/26387&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.citation&q;:[{&q;uuid&q;:&q;34c53b8a-2b1a-4798-a486-1e1503946107&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Von Hase, F. 2010. Is the distribution of Liparia determined by disturbance or mutualism?. University of Cape Town.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.ris&q;:[{&q;uuid&q;:&q;cda2c89b-8772-4cd4-bc70-91a561c36de2&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;\r\nTY  - Thesis / Dissertation\r\nAU  - Von Hase, Fabian G\r\nAB  - I investigated whether the locally endemic Liparia parva was influenced in its distribution by the distribution of its principal pollinator Acomys subspinosus or by rocks acting as buffers against disturbance by fires. Sampling was carried out at Redhill on the Cape Peninsula (South Africa) during the winter of 2010 by trapping rodents with Sherman live and PVC traps, performing vegetation analyses and analyses of its relationship with rocks. My results show no link between Acomys presence and rocks, Acomys and Liparia co-occurrence and flower visitations as a function of distance to rock; however the absence of rocks was associated with the absence of Liparia and an increase in rocks (of up to 1 m height) was associated with an increase in Liparia abundance. This suggests that the distribution of Liparia is not influenced by Acomys and that Liparia is restricted to areas with rocks. I therefore concluded that the distribution of L. parva was determined not by its mutualism, but by rocks as a buffer against disturbance.\r\nDA  - 2010\r\nDB  - OpenUCT\r\nDP  - University of Cape Town\r\nLK  - https://open.uct.ac.za\r\nPB  - University of Cape Town\r\nPY  - 2010\r\nT1  - Is the distribution of Liparia determined by disturbance or mutualism?\r\nTI  - Is the distribution of Liparia determined by disturbance or mutualism?\r\nUR  - http://hdl.handle.net/11427/26387\r\nER  - \r\n&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6df73ae8-4eab-41a9-acc9-bb1611e0fadc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;http://hdl.handle.net/11427/26387&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.vancouvercitation&q;:[{&q;uuid&q;:&q;74ace56e-6712-40ac-ab51-007c90f1c837&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Von Hase FG. Is the distribution of Liparia determined by disturbance or mutualism?. [Thesis]. University of Cape Town ,Faculty of Science ,Department of Biological Sciences, 2010 [cited yyyy month dd]. Available from: http://hdl.handle.net/11427/26387&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;5ad633ec-17f6-43ed-8d34-f35dd2dd28a1&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;eng&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher.department&q;:[{&q;uuid&q;:&q;5cbdd731-b34a-4b49-82cc-a4d39939e436&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Department of Biological Sciences&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher.faculty&q;:[{&q;uuid&q;:&q;f72424bc-356e-4540-8230-424afd53191d&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Faculty of Science&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher.institution&q;:[{&q;uuid&q;:&q;e953cba6-51f6-4006-b1cc-73407460fe06&q;,&q;language&q;:null,&q;value&q;:&q;University of Cape Town&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.subject.other&q;:[{&q;uuid&q;:&q;a4896414-eeda-4e8e-a3d6-47d4f2744203&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Botany&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;31df016e-b0c9-40c5-b29b-7d37109955ea&q;,&q;language&q;:&q;en_ZA&q;,&q;value&q;:&q;Is the distribution of Liparia determined by disturbance or mutualism?&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;5a43acf9-f8dc-4a05-a86a-e1929f399a79&q;,&q;language&q;:null,&q;value&q;:&q;Bachelo