tion\":\"Review your shopping cart and proceed to checkout. Reference-global.com - your gateway to trusted scholarly knowledge.\"},\"home\":{\"title\":\"Paradigm Publishing Services | Books, Journals \u0026 Research\",\"description\":\"Search, discover, and access academic books, journals, and conference proceedings. Reference-global.com - your gateway to trusted scholarly knowledge.\"},\"about\":{\"title\":\"About Us | Paradigm Publishing Services\",\"description\":\"Reference-global.com is your gateway to trusted knowledge. Discover our comprehensive platform for researchers, academics, professionals, and students.\"},\"contact\":{\"title\":\"Contact Us | Paradigm Publishing Services\",\"description\":\"Get in touch with Paradigm Publishing Services. Find contact information for our offices in Boston, London, and Warsaw.\"},\"faq\":{\"title\":\"Frequently Asked Questions | Paradigm\",\"description\":\"Find answers to common questions about Paradigm Publishing Services, content access, subscriptions, and more.\"},\"partners\":{\"title\":\"Our Partners | Paradigm Publishing Services\",\"description\":\"Discover our network of academic and professional publishing partners. Join leading publishers in scholarly communication.\"},\"subjects\":{\"title\":\"Browse by Subject | Paradigm\",\"description\":\"Explore academic content across all subject areas. Find books, journals, and articles in your field of interest.\"},\"publishingEthics\":{\"title\":\"Publishing Ethics | Paradigm Publishing Services\",\"description\":\"Our commitment to ethical publishing practices. Learn about our standards for integrity, transparency, and responsible scholarly communication.\"},\"servicesForLibrarians\":{\"title\":\"Services for Librarians | Paradigm\",\"description\":\"Comprehensive solutions for academic libraries. Manage collections, access usage statistics, and streamline resource delivery.\"},\"servicesForPublishers\":{\"title\":\"Services for Publishers | Paradigm\",\"description\":\"Expert publishing services for academic publishers. From technology and production to visibility and editorial support.\"},\"privacyPolicy\":{\"title\":\"Privacy Policy | Paradigm\",\"description\":\"How we collect, use, and protect your personal data. Read our comprehensive privacy policy.\"},\"termsOfService\":{\"title\":\"Terms of Service | Paradigm\",\"description\":\"Terms and conditions for using reference-global.com. Read our user agreement and policies.\"},\"accessGuide\":{\"title\":\"Access Guide | Paradigm\",\"description\":\"Learn how to set up and manage access to publications on reference-global.com. Guide for librarians and library staff.\"},\"accessibility\":{\"title\":\"Accessibility | Paradigm\",\"description\":\"Our accessibility statement for reference-global.com — WCAG 2.2 conformance, evaluation methods, and accessibility features for journals, books, and conference proceedings.\"}}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L13\"}]\n"])</script><script>self.__next_f.push([1,"13:[\"$\",\"$L14\",null,{\"serverSideToken\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"id\":\"layout-content\",\"className\":\"min-h-screen flex flex-col bg-alabaster\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#main-content\",\"className\":\"absolute left-[-10000px] w-px h-px overflow-hidden focus:fixed focus:top-4 focus:left-4 focus:w-auto focus:h-auto focus:overflow-visible focus:z-[9999] focus:px-4 focus:py-2 focus:bg-signal-blue focus:text-white focus:rounded-full focus:text-body-m focus:font-medium focus:no-underline\",\"children\":\"Skip to main content\"}],[\"$\",\"$L15\",null,{}],[\"$\",\"div\",null,{\"id\":\"main-content\",\"tabIndex\":-1,\"style\":{\"outline\":\"none\"},\"children\":[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",