<meta name="citation_title" content="First record of Wroughton’s Small Spiny Mouse Mus phillipsi Wroughton, 1912 (Rodentia: Muridae) from Odisha, India with notes on diversity and distribution of other rodents"/>
<meta name="citation_language" content="en"/>
<meta name="citation_date" content="2021/02/26"/>
<meta name="citation_volume" content="13"/>
<meta name="citation_issue" content="2"/>
