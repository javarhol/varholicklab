    $(function () { // Notification Badge
        if (typeof isUserLoggedIn === 'function' && isUserLoggedIn()) {
            $('#header-user-notification').show();

            if (typeof Routing !== 'undefined') {
                var url = Routing.generate('app_user_notification_unread_count');
                $.ajax({
                    url: url,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function (total) {
                        var count = parseInt(total);
                        if (!isNaN(count) && count > 0) {
                            $('#notification-count-badge').text(count > 99 ? '99+' : count).show();
                        }
                    },
                    error: function (err) {
                        console.error('Notification fetch error:', err);
                    }
                });
            }
        }

// Dropdown toggles (language & user menu)
        $(document).on('click', '.dropdown .dropdown-toggle', function (e) {
            e.stopPropagation();
            var $dropdown = $(this).closest('.dropdown');
            var $menu = $dropdown.find('.dropdown-menu');
            var isOpen = $menu.is(':visible');
// Close all dropdowns first
            $('.dropdown .dropdown-menu').hide();
            $('.dropdown .dropdown-toggle').attr('aria-expanded', 'false');
            $('.dropdown .dropdown-toggle .fa-chevron-down').css('transform', 'rotate(0deg)');

            if (!isOpen) {
                $menu.show();
                $(this).attr('aria-expanded', 'true');
                $(this).find('.fa-chevron-down').css('transform', 'rotate(180deg)');
            }
        });

// Close dropdowns on outside click
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.dropdown').length) {
                $('.dropdown .dropdown-menu').hide();
                $('.dropdown .dropdown-toggle').attr('aria-expanded', 'false');
                $('.dropdown .dropdown-toggle .fa-chevron-down').css('transform', 'rotate(0deg)');
            }
        });

// Close dropdowns on escape
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') {
                $('.dropdown .dropdown-menu').hide();
                $('.dropdown .dropdown-toggle').attr('aria-expanded', 'false');
                $('.dropdown .dropdown-toggle .fa-chevron-down').css('transform', 'rotate(0deg)');
            }
        });

// Close dropdown when focus leaves
        $(document).on('focusout', '.dropdown', function (e) {
            var $dropdown = $(this);
            setTimeout(function () {
                if (!$dropdown.has(document.activeElement).length && !$dropdown.is(document.activeElement)) {
                    $dropdown.find('.dropdown-menu').hide();
                    $dropdown.find('.dropdown-toggle').attr('aria-expanded', 'false');
                    $dropdown.find('.dropdown-toggle .fa-chevron-down').css('transform', 'rotate(0deg)');
                }
            }, 10);
        });
    });
