<!-- ✅ Скрипт капчи БЕЗ пробелов в URL -->
<script src="https://smartcaptcha.yandexcloud.net/captcha.js" defer></script>

<!-- ✅ Исправленный обработчик формы -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form.callBack');
    const btn = form?.querySelector('button[type="submit"]');
    
    console.log('🔍 Form found:', !!form);
    console.log('🔍 Button found:', !!btn);
    
    if (btn) {
        // Сохраняем исходный текст кнопки
        btn.dataset.originalText = btn.textContent.trim();
        console.log('📝 Original button text:', btn.dataset.originalText);
        
        // 🔒 Блокируем кнопку при загрузке
        btn.disabled = true;
        btn.style.opacity = '0.6';
        btn.style.cursor = 'not-allowed';
        btn.style.backgroundColor = '#ccc';
        btn.textContent = 'Пройдите проверку';
        
        console.log('🔒 Кнопка заблокирована при загрузке');
    }
    // Обработчик отправки формы
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            
            // Проверка токена капчи
            if (!window.captchaToken) {
                alert('Пожалуйста, пройдите капчу');
                return;
            }
            
            console.log('✅ Form submitting with token:', window.captchaToken.substring(0, 20) + '...');
            
            // Визуальная обратная связь при отправке
            const originalBtnText = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Отправка...';
            btn.style.opacity = '0.8';
            
            const formData = new FormData(form);
            
            // Отправка на сервер
            fetch('/ajax/form/callBack.php', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(async response => {
                const text = await response.text();
                console.log('📦 Raw server response:', text);
                
                try {
                    return JSON.parse(text);
                } catch (parseError) {
                    console.warn('⚠️ Ответ не валидный JSON');
                    if (response.ok) {
                        return { STATUS: true, MESSAGE: 'Сообщение отправлено' };
                    }
                    throw parseError;
                }
            })
            .then(data => {
                console.log('✅ Result:', data);
                if (data && data.STATUS) {
                    alert(data.MESSAGE || 'Спасибо, мы свяжемся с вами!');
                    form.reset();
                    
                    // Сброс капчи и кнопки
                    window.captchaToken = null;
                    if (window.Ya?.smartCaptcha) {
                        window.Ya.smartCaptcha.reset();
                    }
                    btn.disabled = true;
                    btn.style.opacity = '0.6';
                    btn.textContent = 'Пройдите проверку';
                    btn.style.backgroundColor = '#ccc';
                } else {
                    alert(data?.MESSAGE || 'Ошибка при отправке формы');
                    btn.disabled = false;
                    btn.style.opacity = '1';
                    btn.textContent = 'Отправить сообщение';
                }
            })
            .catch(err => {
                console.error('🔥 Fetch error:', err);
                if (err.message === 'Failed to fetch') {
                    alert('Ошибка соединения с сервером');
                }
                btn.disabled = false;
                btn.style.opacity = '1';
                btn.textContent = 'Отправить сообщение';
            });
        }, true);
    }
});
</script>

