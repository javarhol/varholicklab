          <span aria-hidden="true">&times;</span></button>
        <h3 class="modal-title"><span class="glyphicon glyphicon-info-sign"></span>確認</h3>
      </div>
      <div class="modal-body">
        <p id="confirm_delete_content"></p>
      </div>
      <div class="modal-footer">
        <button type="button" id="confirm_delete_button" class="btn btn-primary"
          data-pid-value="2579">OK</button>
        <button type="button" class="btn btn-default" data-dismiss="modal">キャンセル</button>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

